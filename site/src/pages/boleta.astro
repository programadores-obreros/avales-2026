---
// boleta.astro — Full ballot image (source of truth: official ballot poster),
// downloadable and shareable by WhatsApp. This image is also the page's LCP,
// so it loads eager + fetchpriority high (see historia.astro/index.astro for
// the shared header pattern this page reuses).
import Layout from '../layouts/Layout.astro';
import { waLink, BOLETA_JPG_PATH, BOLETA_WEBP_PATH, BOLETA_JPG_FILENAME, SHARE_TEXTS } from '../data/share';

const waBoletaFallback = waLink('boleta');
const boletaShareText = SHARE_TEXTS.boleta;
---

<Layout
  title="La boleta — Lista 6 Multicolor, CTA La Matanza"
  description="La boleta completa de la Lista 6 Multicolor para la CTA La Matanza: las 106 candidaturas, para descargar y compartir por WhatsApp."
  ogImage={BOLETA_JPG_PATH}
  ogImageWidth={1080}
  ogImageHeight={1440}
  ogImageType="image/jpeg"
  ogImageAlt="Boleta de la Lista 6 Multicolor para la CTA La Matanza con las 106 candidaturas"
  breadcrumbLabel="La boleta"
>
  <section class="bg-light pt-24 pb-16 md:pt-28 md:pb-24">
    <div class="mx-auto max-w-2xl px-4 text-center sm:px-6 lg:px-8">
      <p class="font-display text-xs font-bold uppercase tracking-[0.3em] text-primary-dark">Lista 6 Multicolor</p>
      <h1 class="mt-2 font-display text-2xl font-black uppercase tracking-tight text-dark sm:text-4xl">
        La <span class="text-gradient-multi">boleta</span>
      </h1>
      <div class="mx-auto mt-4 h-1 w-20 rounded-full gradient-multi"></div>
      <p class="mx-auto mt-5 max-w-md font-body text-sm leading-relaxed text-dark/70 sm:text-base">
        3 de noviembre de 2026 · CTA La Matanza
      </p>

      <!-- Ballot image: this is the page's LCP element. -->
      <div class="mx-auto mt-8 max-w-xs sm:max-w-sm">
        <img
          src={BOLETA_WEBP_PATH}
          width="900"
          height="1200"
          alt="Boleta de la Lista 6 Multicolor para la CTA La Matanza con las 106 candidaturas"
          loading="eager"
          fetchpriority="high"
          decoding="sync"
          class="w-full rounded-2xl border border-dark/10 shadow-lg"
        />
      </div>

      <!-- Actions -->
      <div class="mx-auto mt-8 flex max-w-xs flex-col gap-3">
        <button
          type="button"
          data-share-boleta
          data-share-text={boletaShareText}
          data-share-file={BOLETA_JPG_PATH}
          data-share-filename={BOLETA_JPG_FILENAME}
          data-share-fallback={waBoletaFallback}
          class="inline-flex min-h-[48px] items-center justify-center gap-2 rounded-full bg-secondary px-6 py-3 font-display text-sm font-bold text-white shadow-md transition hover:bg-secondary-dark disabled:opacity-70"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.96L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.2h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.15h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.22 8.22 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24 2.2 0 4.27.86 5.83 2.42a8.18 8.18 0 0 1 2.41 5.83c0 4.55-3.7 8.23-8.24 8.23Zm4.52-6.17c-.25-.12-1.47-.72-1.7-.81-.23-.08-.39-.12-.56.13-.17.25-.64.81-.78.97-.14.17-.29.19-.53.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.39-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.15.16-.25.25-.42.08-.17.04-.31-.02-.44-.06-.12-.56-1.35-.77-1.85-.2-.48-.41-.42-.56-.43-.14-.01-.31-.01-.48-.01-.17 0-.44.06-.67.31-.23.25-.87.85-.87 2.08 0 1.23.89 2.42 1.02 2.59.12.17 1.75 2.67 4.24 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.08.15-1.18-.06-.1-.23-.16-.48-.28Z"/>
          </svg>
          <span data-share-label>Compartir la boleta por WhatsApp</span>
        </button>

        <a
          href={BOLETA_JPG_PATH}
          download
          class="inline-flex min-h-[48px] items-center justify-center gap-2 rounded-full border-2 border-dark/15 bg-white px-6 py-3 font-display text-sm font-bold text-dark transition hover:border-primary hover:text-primary-dark"
        >
          Descargar la boleta
        </a>

        <a
          href="/lista"
          class="inline-flex min-h-[44px] items-center justify-center gap-2 font-body text-sm font-semibold text-primary-dark underline underline-offset-2 hover:text-primary"
        >
          Ver la lista con buscador
        </a>
      </div>
    </div>
  </section>
</Layout>
