---
// index.astro — Home: hero, both slogans, countdown, secretariado highlight, CTAs.
import Layout from '../layouts/Layout.astro';
import CandidatoCard from '../components/CandidatoCard.astro';
import { CANDIDATURAS, BLOQUES } from '../data/lista';
import {
  LISTA_NUMERO,
  SLOGAN_1,
  SLOGAN_2,
  ELECTION_DATE,
  ELECTION_DATE_CONFIRMED,
} from '../data/site';

const secretariado = CANDIDATURAS.filter((c) => c.bloque === 'secretariado').sort(
  (a, b) => a.orden - b.orden
);
const bloqueLabel = Object.fromEntries(BLOQUES.map((b) => [b.id, b.titulo]));

const multicolorLetters = 'MULTICOLOR'.split('');
---

<Layout title="Lista 6 Multicolor — CTA La Matanza">
  <!-- ═══ Hero ═══ -->
  <section
    id="inicio"
    class="relative flex min-h-[88svh] flex-col items-center justify-center overflow-hidden bg-white px-4 pt-24 pb-16 text-center sm:px-6 lg:px-8"
    aria-label="Sección principal de campaña"
  >
    <!-- Light ground on purpose: the rainbow wordmark only reads on white (like the ballot). -->
    <div class="absolute -top-24 -left-24 h-72 w-72 rounded-full bg-accent/10 blur-3xl" aria-hidden="true"></div>
    <div class="absolute -bottom-24 -right-24 h-72 w-72 rounded-full bg-sky/15 blur-3xl" aria-hidden="true"></div>
    <div class="absolute top-0 left-0 right-0 h-1.5 gradient-multi-horizontal" aria-hidden="true"></div>
    <div class="absolute bottom-0 left-0 right-0 h-1.5 gradient-multi-horizontal" aria-hidden="true"></div>

    <div class="relative z-10 mx-auto flex w-full max-w-4xl flex-col items-center">
      <span class="animate-fade-in-up inline-flex items-center gap-2 rounded-full border border-dark/10 bg-light px-4 py-1.5 text-xs font-semibold uppercase tracking-widest text-dark/70 sm:text-sm">
        <span class="inline-block h-2 w-2 rounded-full bg-primary animate-pulse-soft"></span>
        Elecciones CTA La Matanza · 2026
      </span>

      <h1 class="animate-fade-in-up mt-6 font-display font-black leading-none tracking-tight" style="animation-delay: 0.1s;">
        <span class="block text-5xl text-dark sm:text-6xl md:text-7xl">
          LISTA {LISTA_NUMERO}
        </span>
        <span class="wordmark-multicolor mt-1 block text-[2.75rem] sm:text-7xl md:text-8xl leading-none">
          {multicolorLetters.map((letter) => (
            <span aria-hidden="true">{letter}</span>
          ))}
          <!-- Last child on purpose: letter colors are assigned with nth-child. -->
          <span class="sr-only">MULTICOLOR</span>
        </span>
        <span class="mt-3 block text-lg text-dark/80 sm:text-2xl md:text-3xl">CTA La Matanza</span>
      </h1>

      <div class="animate-fade-in-up mt-8 flex flex-col gap-3 sm:mt-10" style="animation-delay: 0.25s;">
        <p class="font-display text-xl font-bold text-primary-dark sm:text-2xl">{SLOGAN_1}</p>
        <p class="mx-auto max-w-2xl text-base text-dark/75 sm:text-lg">{SLOGAN_2}</p>
      </div>

      <!-- Countdown -->
      <div class="animate-fade-in-up mt-10 sm:mt-12" style="animation-delay: 0.4s;">
        {
          !ELECTION_DATE_CONFIRMED && (
            <p class="mb-3 inline-flex items-center gap-1.5 rounded-full border border-primary/30 bg-primary/5 px-3 py-1 text-[11px] font-semibold uppercase tracking-wide text-primary-dark sm:text-xs">
              Fecha estimada — a confirmar
            </p>
          )
        }
        <p class="mb-4 text-xs uppercase tracking-widest text-dark/70 sm:text-sm">
          Faltan <span id="countdown-days-text" class="font-bold text-primary-dark">—</span> días
        </p>
        <div class="flex items-center justify-center gap-2 sm:gap-4" data-election-date={ELECTION_DATE}>
          <div class="flex h-16 w-16 flex-col items-center justify-center rounded-xl bg-dark shadow-lg sm:h-24 sm:w-24">
            <span id="cd-days" class="font-display text-2xl font-black leading-none tabular-nums text-white sm:text-4xl">—</span>
            <span class="mt-1 text-[11px] uppercase tracking-widest text-white/70 sm:text-xs">días</span>
          </div>
          <span class="select-none pb-4 font-display text-2xl font-black text-dark/30 sm:pb-6 sm:text-4xl" aria-hidden="true">:</span>
          <div class="flex h-16 w-16 flex-col items-center justify-center rounded-xl bg-dark shadow-lg sm:h-24 sm:w-24">
            <span id="cd-hours" class="font-display text-2xl font-black leading-none tabular-nums text-white sm:text-4xl">—</span>
            <span class="mt-1 text-[11px] uppercase tracking-widest text-white/70 sm:text-xs">horas</span>
          </div>
          <span class="select-none pb-4 font-display text-2xl font-black text-dark/30 sm:pb-6 sm:text-4xl" aria-hidden="true">:</span>
          <div class="flex h-16 w-16 flex-col items-center justify-center rounded-xl bg-dark shadow-lg sm:h-24 sm:w-24">
            <span id="cd-minutes" class="font-display text-2xl font-black leading-none tabular-nums text-white sm:text-4xl">—</span>
            <span class="mt-1 text-[11px] uppercase tracking-widest text-white/70 sm:text-xs">min</span>
          </div>
          <span class="select-none pb-4 font-display text-2xl font-black text-dark/30 sm:pb-6 sm:text-4xl" aria-hidden="true">:</span>
          <div class="flex h-16 w-16 flex-col items-center justify-center rounded-xl bg-primary shadow-lg sm:h-24 sm:w-24">
            <span id="cd-seconds" class="font-display text-2xl font-black leading-none tabular-nums text-white sm:text-4xl">—</span>
            <span class="mt-1 text-[11px] uppercase tracking-widest text-white sm:text-xs">seg</span>
          </div>
        </div>
        <p id="countdown-past" class="mt-4 hidden font-display text-sm font-bold text-primary-dark">
          ¡Ya pasó la fecha estimada! Consultá la fecha confirmada en Cómo votar.
        </p>
      </div>

      <!-- CTAs -->
      <div class="animate-fade-in-up mt-10 flex w-full flex-col items-stretch gap-3 px-2 sm:mt-12 sm:w-auto sm:flex-row sm:px-0" style="animation-delay: 0.55s;">
        <a
          href="/lista"
          class="inline-flex min-h-[48px] items-center justify-center gap-2 rounded-full bg-primary px-7 py-3.5 font-display text-base font-bold text-white shadow-lg transition-all duration-300 hover:bg-primary-dark active:scale-95 motion-safe:hover:scale-105"
        >
          Conocé la lista completa
        </a>
        <a
          href="/sumate"
          class="inline-flex min-h-[48px] items-center justify-center gap-2 rounded-full border-2 border-dark/15 bg-white px-7 py-3.5 font-display text-base font-bold text-dark transition-all duration-300 hover:border-primary hover:text-primary-dark active:scale-95 motion-safe:hover:scale-105"
        >
          Sumate
        </a>
      </div>
    </div>
  </section>

  <!-- ═══ Secretariado highlight ═══ -->
  <section id="secretariado" class="bg-light py-16 md:py-24" aria-label="Secretariado de la lista">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <p class="font-display text-xs font-bold uppercase tracking-[0.3em] text-primary-dark">Secretariado</p>
        <h2 class="mt-2 font-display text-2xl font-black uppercase tracking-tight text-dark sm:text-4xl">
          Quiénes <span class="text-gradient-multi">encabezan</span> la lista
        </h2>
        <div class="mx-auto mt-4 h-1 w-20 rounded-full gradient-multi"></div>
      </div>

      <div class="mt-10 grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 lg:gap-4">
        {secretariado.map((c, i) => (
          <CandidatoCard candidatura={c} bloqueLabel={bloqueLabel[c.bloque]} loading={i < 4 ? 'eager' : 'lazy'} />
        ))}
      </div>

      <div class="mt-10 text-center">
        <a
          href="/lista"
          class="inline-flex min-h-[44px] items-center justify-center gap-2 rounded-full bg-primary px-6 py-3 font-display text-sm font-bold text-white shadow-md transition hover:opacity-90"
        >
          Ver los 106 candidatxs
        </a>
      </div>
    </div>
  </section>

  <script define:vars={{ electionDate: ELECTION_DATE }}>
    (function () {
      const TARGET_DATE = new Date(electionDate);

      const elDays = document.getElementById('cd-days');
      const elHours = document.getElementById('cd-hours');
      const elMinutes = document.getElementById('cd-minutes');
      const elSeconds = document.getElementById('cd-seconds');
      const elDaysText = document.getElementById('countdown-days-text');
      const elPast = document.getElementById('countdown-past');

      function pad(n) {
        return String(n).padStart(2, '0');
      }

      function tick() {
        const now = new Date();
        const diff = TARGET_DATE.getTime() - now.getTime();

        if (Number.isNaN(diff)) return;

        if (diff <= 0) {
          if (elDays) elDays.textContent = '0';
          if (elHours) elHours.textContent = '00';
          if (elMinutes) elMinutes.textContent = '00';
          if (elSeconds) elSeconds.textContent = '00';
          if (elDaysText) elDaysText.textContent = '0';
          if (elPast) elPast.classList.remove('hidden');
          return;
        }

        const totalSeconds = Math.floor(diff / 1000);
        const days = Math.floor(totalSeconds / 86400);
        const hours = Math.floor((totalSeconds % 86400) / 3600);
        const minutes = Math.floor((totalSeconds % 3600) / 60);
        const seconds = totalSeconds % 60;

        if (elDays) elDays.textContent = String(days);
        if (elHours) elHours.textContent = pad(hours);
        if (elMinutes) elMinutes.textContent = pad(minutes);
        if (elSeconds) elSeconds.textContent = pad(seconds);
        if (elDaysText) elDaysText.textContent = String(days);
      }

      tick();
      setInterval(tick, 1000);
    })();
  </script>
</Layout>
