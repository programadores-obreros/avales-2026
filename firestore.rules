rules_version = '2';
// Constancias de fiscales (ctamulticolor.com.ar/constancias): solo la cuenta única del equipo
// (la clave que escriben los docentes) puede leer o escribir. Todo lo demás, cerrado.
service cloud.firestore {
  match /databases/{database}/documents {
    function esEquipo() {
      return request.auth != null && request.auth.token.email == 'constancias@ctamulticolor.com.ar';
    }
    function texto(v, max) { return v is string && v.size() <= max; }
    // tipo: 'mesa' (Formulario N°3, lleva mesa) o 'general' (N°2, sin mesa). Sin tipo = mesa (cargas viejas).
    function fiscalValido(d) {
      return d.keys().hasOnly(['tipo', 'mesa', 'nombre', 'dni', 'localidad', 'provincia', 'rol', 'creadoEn'])
        && d.get('tipo', 'mesa') in ['mesa', 'general']
        && texto(d.mesa, 10) && (d.mesa.size() > 0 || d.get('tipo', 'mesa') == 'general')
        && texto(d.nombre, 80) && d.nombre.size() > 0
        && d.dni is string && d.dni.matches('^[0-9]{7,9}$')
        && texto(d.localidad, 40) && texto(d.provincia, 40) && texto(d.rol, 40);
    }

    match /fiscales/{id} {
      allow read, delete: if esEquipo();
      allow create: if esEquipo() && fiscalValido(request.resource.data)
        && request.resource.data.creadoEn == request.time;
      allow update: if esEquipo() && fiscalValido(request.resource.data)
        && request.resource.data.creadoEn == resource.data.creadoEn;
    }

    // Padrón de afiliados CTA La Matanza (solo DNI → apellido y nombre). Consulta de a un DNI:
    // ni con la clave se puede listar/descargar entero. Se carga por fuera (admin), nunca desde la web.
    match /padron/{dni} {
      allow get: if esEquipo();
    }

    match /config/{id} {
      allow read: if esEquipo() && id in ['diseno', 'diseno-general'];
      allow write: if esEquipo() && id in ['diseno', 'diseno-general']
        && request.resource.data.keys().hasOnly(['json', 'actualizado'])
        && request.resource.data.json is string && request.resource.data.json.size() < 20000;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
