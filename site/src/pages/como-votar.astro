---
// como-votar.astro — Date (with "a confirmar" state), requisitos [PENDIENTE],
// and a note that the "¿dónde voto?" lookup arrives when mesas are assigned.
// No lookup implemented in this phase (mesas not assigned yet).
import Layout from '../layouts/Layout.astro';
import Pendiente from '../components/Pendiente.astro';
import { ELECTION_DATE, ELECTION_DATE_CONFIRMED } from '../data/site';

const fechaFormateada = new Intl.DateTimeFormat('es-AR', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'America/Argentina/Buenos_Aires',
}).format(new Date(ELECTION_DATE));
---

<Layout
  title="Cómo votar — Lista 6 Multicolor, CTA La Matanza"
  description="Fecha, requisitos y todo lo que necesitás saber para votar a la Lista 6 Multicolor en la CTA La Matanza."
>
  <section class="bg-light pt-24 pb-16 md:pt-28 md:pb-24">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <p class="text-center font-display text-xs font-bold uppercase tracking-[0.3em] text-primary-dark">
        Elecciones CTA La Matanza
      </p>
      <h1 class="mt-2 text-center font-display text-2xl font-black uppercase tracking-tight text-dark sm:text-4xl">
        Cómo <span class="text-gradient-multi">votar</span>
      </h1>
      <div class="mx-auto mt-4 h-1 w-20 rounded-full gradient-multi"></div>

      <!-- Date -->
      <div class="mt-10 rounded-2xl bg-white p-6 text-center shadow-sm sm:p-8">
        {
          !ELECTION_DATE_CONFIRMED && (
            <p class="mb-3 inline-flex items-center gap-1.5 rounded-full border border-primary/30 bg-primary/5 px-3 py-1 text-[11px] font-semibold uppercase tracking-wide text-primary-dark">
              Fecha estimada — a confirmar
            </p>
          )
        }
        <p class="font-display text-2xl font-black capitalize text-dark sm:text-3xl">{fechaFormateada}</p>
        <p class="mt-2 font-body text-sm text-dark/70">
          {ELECTION_DATE_CONFIRMED
            ? 'Fecha confirmada por la CTA La Matanza.'
            : 'Todavía no hay fecha oficial confirmada para La Matanza. Actualizamos este dato en cuanto la central lo publique.'}
        </p>
      </div>

      <!-- Dónde voto -->
      <div class="mt-8 rounded-2xl border-2 border-dashed border-sky/50 bg-sky/10 p-6">
        <p class="flex items-center gap-2 font-display text-xs font-bold uppercase tracking-widest text-dark">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10" />
            <line x1="12" y1="16" x2="12" y2="12" />
            <line x1="12" y1="8" x2="12.01" y2="8" />
          </svg>
          ¿Dónde voto?
        </p>
        <p class="mt-2 font-body text-sm text-dark/70">
          Todavía no están asignadas las mesas para esta elección. En cuanto la CTA La Matanza las
          publique, vamos a habilitar acá una consulta por DNI para saber en qué mesa te toca votar.
        </p>
      </div>

      <!-- Requisitos -->
      <div class="mt-8">
        <h2 class="font-display text-lg font-black uppercase tracking-tight text-dark">Requisitos para votar</h2>
        <div class="mt-3">
          <Pendiente descripcion="los requisitos para votar en la elección de la CTA La Matanza (padrón, DNI, afiliación, etc.)" />
        </div>
      </div>
    </div>
  </section>
</Layout>
