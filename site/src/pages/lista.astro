---
// lista.astro — La Lista: all 106 candidaturas grouped by bloque, with
// client-side search (accent/case-insensitive) and bloque filter chips.
// Works fully without JS: every candidatura is rendered server-side.
import Layout from '../layouts/Layout.astro';
import CandidatoCard from '../components/CandidatoCard.astro';
import { CANDIDATURAS, BLOQUES } from '../data/lista';

const grouped = BLOQUES.map((bloque) => ({
  ...bloque,
  candidaturas: CANDIDATURAS.filter((c) => c.bloque === bloque.id).sort((a, b) => a.orden - b.orden),
}));

// Search matches directly against the DOM's data-cand-nombre attributes below,
// so the client script only needs the total count for the status message.
const totalCandidaturas = CANDIDATURAS.length;
---

<Layout
  title="La Lista — Lista 6 Multicolor, CTA La Matanza"
  description="Los 106 candidatxs de la Lista 6 Multicolor para la CTA La Matanza: secretariado, vocales, comisión revisora y congresales."
  breadcrumbLabel="La Lista"
>
  <section class="bg-light pt-24 pb-16 md:pt-28 md:pb-24">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <p class="font-display text-xs font-bold uppercase tracking-[0.3em] text-primary-dark">Lista 6 Multicolor</p>
        <h1 class="mt-2 font-display text-2xl font-black uppercase tracking-tight text-dark sm:text-4xl">
          Lxs candidatxs de la <span class="text-gradient-multi">Lista 6 Multicolor</span> La Matanza
        </h1>
        <div class="mx-auto mt-4 h-1 w-20 rounded-full gradient-multi"></div>
        <a
          href="/boleta"
          class="mt-4 inline-flex min-h-[44px] items-center justify-center gap-1.5 font-body text-sm font-semibold text-primary-dark underline underline-offset-2 hover:text-primary"
        >
          Ver la boleta oficial
        </a>
      </div>

      <!-- Search -->
      <div class="mx-auto mt-8 max-w-md">
        <label for="cand-search" class="sr-only">Buscar candidatx por nombre</label>
        <div class="relative">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="pointer-events-none absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-dark/40"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="8" />
            <line x1="21" y1="21" x2="16.65" y2="16.65" />
          </svg>
          <input
            id="cand-search"
            type="search"
            inputmode="search"
            autocomplete="off"
            placeholder="Buscar por nombre…"
            class="w-full min-h-[44px] rounded-full border border-dark/15 bg-white py-3 pl-11 pr-4 font-body text-sm text-dark shadow-sm transition focus:border-primary"
          />
        </div>
        <p id="cand-search-status" class="mt-2 text-center text-xs text-dark/70" aria-live="polite">
          {CANDIDATURAS.length} candidaturas en total
        </p>
      </div>

      <!-- Bloque filter chips -->
      <!-- Mobile: one swipeable row (a wrapped grid of 6 chips pushed the list below the fold). -->
      <div id="bloque-filters" class="-mx-4 mt-6 flex snap-x gap-2 overflow-x-auto px-4 pb-2 [scrollbar-width:none] *:shrink-0 *:snap-start *:whitespace-nowrap md:mx-0 md:flex-wrap md:justify-center md:overflow-visible md:px-0" role="group" aria-label="Filtrar por bloque">
        <button type="button" data-filter="all" class="bloque-filter-btn is-active" aria-pressed="true">
          Todxs <span class="font-normal">({CANDIDATURAS.length})</span>
        </button>
        {grouped.map((b) => (
          <button type="button" data-filter={b.id} class="bloque-filter-btn" aria-pressed="false">
            {b.titulo} <span class="font-normal">({b.candidaturas.length})</span>
          </button>
        ))}
      </div>

      <!-- Groups -->
      <div id="cand-groups" class="mt-12 flex flex-col gap-14">
        {grouped.map((b, gi) => (
          <div data-bloque-group={b.id}>
            <div class="mb-5 flex items-baseline justify-between gap-3 border-b border-dark/10 pb-2">
              <h2 class="font-display text-lg font-black uppercase tracking-tight text-dark sm:text-xl">
                {b.titulo}
              </h2>
              <span class="shrink-0 font-body text-xs font-semibold text-dark/70">
                {b.candidaturas.length} {b.candidaturas.length === 1 ? 'candidatx' : 'candidatxs'}
              </span>
            </div>
            {b.candidaturas.length === 0 ? (
              <p class="rounded-xl bg-white p-6 text-center text-sm text-dark/70 italic shadow-sm">
                Todavía no hay candidaturas cargadas en este bloque (contenido de ejemplo pendiente de
                reemplazo por la transcripción oficial).
              </p>
            ) : (
              <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 lg:gap-4">
                {b.candidaturas.map((c, i) => (
                  <div data-cand-item data-cand-nombre={c.nombre} data-cand-bloque={c.bloque}>
                    <CandidatoCard candidatura={c} bloqueLabel={b.titulo} loading={gi === 0 && i < 2 ? 'eager' : 'lazy'} />
                  </div>
                ))}
              </div>
            )}
          </div>
        ))}
      </div>

      <p id="cand-empty" class="mt-10 hidden text-center text-sm text-dark/70 italic" aria-live="polite">
        No encontramos candidatxs con ese nombre.
      </p>
    </div>
  </section>

  <script define:vars={{ totalCandidaturas }}>
    (function () {
      // Accent- and case-insensitive normalization (e.g. "Peréz" matches "perez").
      function normalize(s) {
        return s
          .normalize('NFD')
          .replace(/[̀-ͯ]/g, '')
          .toLowerCase()
          .trim();
      }

      const input = document.getElementById('cand-search');
      const status = document.getElementById('cand-search-status');
      const emptyMsg = document.getElementById('cand-empty');
      const groups = document.querySelectorAll('[data-bloque-group]');
      const filterBtns = document.querySelectorAll('#bloque-filters .bloque-filter-btn');

      let activeFilter = 'all';
      let query = '';

      function applyFilters() {
        let totalVisible = 0;

        groups.forEach((group) => {
          const bloqueId = group.getAttribute('data-bloque-group');
          const bloqueMatches = activeFilter === 'all' || activeFilter === bloqueId;

          const items = group.querySelectorAll('[data-cand-item]');
          let groupVisible = 0;

          items.forEach((item) => {
            const nombre = item.getAttribute('data-cand-nombre') || '';
            const queryMatches = query === '' || normalize(nombre).includes(query);
            const show = bloqueMatches && queryMatches;
            item.style.display = show ? '' : 'none';
            if (show) groupVisible++;
          });

          const groupHasNoItems = items.length === 0;
          group.style.display = bloqueMatches && (groupVisible > 0 || groupHasNoItems) ? '' : 'none';
          totalVisible += groupVisible;
        });

        if (status) {
          status.textContent =
            query === ''
              ? `${totalCandidaturas} candidaturas en total`
              : `${totalVisible} resultado${totalVisible === 1 ? '' : 's'} para "${input.value}"`;
        }

        if (emptyMsg) {
          emptyMsg.classList.toggle('hidden', totalVisible > 0);
        }
      }

      input?.addEventListener('input', () => {
        query = normalize(input.value);
        applyFilters();
      });

      filterBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          activeFilter = btn.dataset.filter || 'all';
          filterBtns.forEach((b) => {
            b.classList.remove('is-active');
            b.setAttribute('aria-pressed', 'false');
          });
          btn.classList.add('is-active');
          btn.setAttribute('aria-pressed', 'true');
          applyFilters();
        });
      });
    })();
  </script>

  <style>
    .bloque-filter-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
      min-height: 40px;
      padding: 0.5rem 0.9rem;
      border-radius: 9999px;
      background: white;
      border: 1.5px solid rgb(0 0 0 / 0.1);
      font-family: var(--font-display, inherit);
      font-size: 0.7rem;
      font-weight: 700;
      color: rgb(0 0 0 / 0.65);
      text-transform: uppercase;
      letter-spacing: 0.03em;
      transition: all 0.2s;
      cursor: pointer;
    }
    .bloque-filter-btn:hover {
      border-color: rgb(196 30 42 / 0.4);
      color: rgb(196 30 42);
    }
    .bloque-filter-btn.is-active {
      background: linear-gradient(90deg, #c41e2a, #e91e8e);
      border-color: transparent;
      color: white;
    }
  </style>
</Layout>
