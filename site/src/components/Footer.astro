---
// Footer.astro — Desktop-visible closing section. On mobile the BottomNav
// covers primary navigation, so this footer only needs to appear above it.
import { LISTA_NOMBRE, REDES, CONTACTO_EMAIL } from '../data/site';
import Pendiente from './Pendiente.astro';

const year = new Date().getFullYear();
const hayRedes = Object.values(REDES).some((v) => v !== null);
---

<footer class="relative border-t border-dark/10 bg-dark text-white" aria-label="Pie de página">
  <div class="gradient-multi-horizontal h-1 w-full"></div>
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8">
    <div class="grid gap-8 sm:grid-cols-3">
      <div>
        <p class="text-rainbow font-display text-lg font-black tracking-tight">{LISTA_NOMBRE}</p>
        <p class="mt-1 font-body text-sm text-white/50">CTA La Matanza</p>
      </div>

      <nav aria-label="Enlaces del pie">
        <p class="font-display text-xs font-bold uppercase tracking-widest text-white/70">Navegación</p>
        <ul class="mt-3 flex flex-col gap-2 font-body text-sm" role="list">
          <li><a href="/lista" class="hover:text-white transition-colors">La Lista</a></li>
          <li><a href="/por-que-la-cta" class="hover:text-white transition-colors">Por qué la CTA</a></li>
          <li><a href="/como-votar" class="hover:text-white transition-colors">Cómo votar</a></li>
          <li><a href="/sumate" class="hover:text-white transition-colors">Sumate</a></li>
        </ul>
      </nav>

      <div>
        <p class="font-display text-xs font-bold uppercase tracking-widest text-white/70">Contacto</p>
        <div class="mt-3 font-body text-sm">
          {
            CONTACTO_EMAIL ? (
              <a href={`mailto:${CONTACTO_EMAIL}`} class="hover:text-white transition-colors">
                {CONTACTO_EMAIL}
              </a>
            ) : (
              <Pendiente descripcion="email/canal de contacto" variant="inline" />
            )
          }
        </div>
        <div class="mt-3">
          {!hayRedes && <Pendiente descripcion="redes sociales de la lista" variant="inline" />}
        </div>
      </div>
    </div>

    <div class="mt-10 border-t border-white/10 pt-6 text-center font-body text-xs text-white/70">
      <p>&copy; {year} {LISTA_NOMBRE} — CTA La Matanza.</p>
    </div>
  </div>
</footer>
