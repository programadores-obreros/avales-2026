---
// historia.astro — "Historia política de la CTA": mobile-first vertical timeline
// across four eras, every milestone sourced. See src/data/historia.ts for content
// (facts verified against each source URL on 2026-09-28).
import Layout from '../layouts/Layout.astro';
import Pendiente from '../components/Pendiente.astro';
import { ERAS, PRINCIPIOS, PRINCIPIOS_FUENTE } from '../data/historia';
import { SLOGAN_1, SLOGAN_2 } from '../data/site';

// Tailwind's scanner needs literal class strings (see CandidatoCard.astro), so each
// era gets its own static entry instead of one built with `${}` interpolation.
// Rainbow colors are only ever used as dot/line/badge backgrounds below — copy
// text always stays text-dark, per the site's contrast rules.
const eraStyle: Record<string, { marker: string; badge: string; dot: string }> = {
  nacimiento: {
    marker: 'bg-primary text-white',
    badge: 'bg-primary text-white',
    dot: 'bg-primary',
  },
  'resistencia-90': {
    marker: 'bg-accent-dark text-white',
    badge: 'bg-accent-dark text-white',
    dot: 'bg-accent-dark',
  },
  ruptura: {
    marker: 'bg-secondary text-white',
    badge: 'bg-secondary text-white',
    dot: 'bg-secondary',
  },
  '2026': {
    marker: 'bg-golden text-dark',
    badge: 'bg-golden text-dark',
    dot: 'bg-orange',
  },
};

const HOY = Date.now();
function esFuturo(fecha: string): boolean {
  const iso = fecha.length === 4 ? `${fecha}-01-01` : fecha.length === 7 ? `${fecha}-01` : fecha;
  return new Date(iso).getTime() > HOY;
}
---

<Layout
  title="Historia política — Lista 6 Multicolor, CTA La Matanza"
  description="Cómo nació la CTA, qué planteaba, cómo se rompió y qué está en juego en la elección del 3 de noviembre. Cada hito con su fuente."
>
  <!-- Header -->
  <section class="bg-light pt-24 pb-10 md:pt-28 md:pb-12">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8">
      <p class="font-display text-xs font-bold uppercase tracking-[0.3em] text-primary-dark">Historia política</p>
      <h1 class="mt-2 font-display text-2xl font-black uppercase tracking-tight text-dark sm:text-4xl">
        De Burzaco a <span class="text-gradient-multi">2026</span>
      </h1>
      <div class="mx-auto mt-4 h-1 w-20 rounded-full gradient-multi"></div>
      <p class="mx-auto mt-5 max-w-xl font-body text-sm leading-relaxed text-dark/70 sm:text-base">
        Cómo nació la CTA, qué planteaba, cómo se rompió y qué está en juego en esta elección. Cada
        hito tiene su fuente.
      </p>
    </div>
  </section>

  <!-- Era navigator: sticky below the fixed Nav (header is 56px + 4px gradient bar = 60px). -->
  <nav
    id="era-nav"
    aria-label="Navegar por eras de la historia"
    class="sticky top-[60px] z-30 border-y border-dark/10 bg-light/95 backdrop-blur-sm"
  >
    <div class="mx-auto max-w-4xl px-4 py-2.5 sm:px-6 lg:px-8">
      <div
        id="era-chips"
        class="-mx-4 flex snap-x gap-2 overflow-x-auto px-4 [scrollbar-width:none] *:shrink-0 *:snap-start *:whitespace-nowrap md:mx-0 md:flex-wrap md:justify-center md:overflow-visible md:px-0"
      >
        {
          ERAS.map((era) => (
            <a href={`#era-${era.id}`} data-era-chip={era.id} class="era-chip" aria-current="false">
              <span class="block leading-tight">{era.titulo}</span>
              <span class="block text-[10px] font-normal leading-tight">{era.periodo}</span>
            </a>
          ))
        }
      </div>
    </div>
  </nav>

  <!-- Timeline -->
  <section class="bg-light py-12 md:py-16">
    <div class="relative mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <!-- Continuous vertical line, spans every era. Centered at 22px to match the
           era-marker (36px wide, left-[4px]) and hito-dot (14px wide, left-[15px]) centers below. -->
      <div class="absolute left-[20px] top-1 bottom-1 w-1 rounded-full gradient-multi" aria-hidden="true"></div>

      <div class="flex flex-col gap-14">
        {
          ERAS.map((era, eraIdx) => {
            const style = eraStyle[era.id];
            return (
              <section id={`era-${era.id}`} class="scroll-mt-[104px]">
                <div class="relative pl-14">
                  <span
                    class:list={[
                      'absolute left-[4px] top-0 flex h-9 w-9 items-center justify-center rounded-full font-display text-sm font-black ring-4 ring-light',
                      style.marker,
                    ]}
                    aria-hidden="true"
                  >
                    {eraIdx + 1}
                  </span>
                  <span
                    class:list={[
                      'inline-block rounded-full px-2.5 py-0.5 font-display text-[11px] font-bold uppercase tracking-widest',
                      style.badge,
                    ]}
                  >
                    {era.periodo}
                  </span>
                  <h2 class="mt-1.5 font-display text-xl font-black uppercase tracking-tight text-dark sm:text-2xl">
                    {era.titulo}
                  </h2>
                  <p class="mt-2 font-body text-sm leading-relaxed text-dark/70">{era.resumen}</p>
                </div>

                {eraIdx === 0 && (
                  <div class="mt-8 rounded-2xl bg-white p-5 shadow-sm sm:p-7">
                    <h2 class="font-display text-lg font-black uppercase tracking-tight text-dark">
                      Los tres principios fundacionales
                    </h2>
                    <ol class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-3" role="list">
                      {PRINCIPIOS.map((p, i) => (
                        <li class="rounded-xl border border-dark/10 bg-light p-4">
                          <span class="flex h-7 w-7 items-center justify-center rounded-full bg-primary font-display text-xs font-black text-white">
                            {i + 1}
                          </span>
                          <p class="mt-2 font-display text-sm font-bold text-dark">{p.titulo}</p>
                          <p class="mt-1 font-body text-xs leading-relaxed text-dark/70">{p.texto}</p>
                        </li>
                      ))}
                    </ol>
                    <a
                      href={PRINCIPIOS_FUENTE.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="mt-4 inline-block font-body text-xs font-semibold text-primary-dark underline underline-offset-2"
                    >
                      Fuente: {PRINCIPIOS_FUENTE.nombre} ↗
                    </a>
                  </div>
                )}

                <ol class="mt-8 flex flex-col gap-6" role="list">
                  {era.hitos.map((hito) => {
                    const futuro = esFuturo(hito.fecha);
                    const esAnalisis = hito.tipo === 'analisis';
                    return (
                      <li class="reveal relative pl-14">
                        <span
                          class:list={[
                            'absolute left-[15px] top-1.5 h-3.5 w-3.5 rounded-full border-2 border-light',
                            futuro ? 'bg-primary' : style.dot,
                          ]}
                          aria-hidden="true"
                        />
                        <article
                          class:list={[
                            'rounded-2xl bg-white p-4 shadow-sm sm:p-5',
                            esAnalisis && 'border-2 border-dashed border-dark/25',
                            futuro && 'ring-2 ring-primary/40',
                          ]}
                        >
                          <div class="flex flex-wrap items-center gap-2">
                            <time datetime={hito.fecha} class="font-display text-xs font-bold tabular-nums text-dark">
                              {hito.fechaTexto}
                            </time>
                            {esAnalisis && (
                              <span class="rounded-full border border-dark/20 bg-light px-2 py-0.5 font-display text-[10px] font-bold uppercase tracking-widest text-dark/70">
                                Análisis
                              </span>
                            )}
                            {futuro && (
                              <span class="rounded-full bg-primary px-2 py-0.5 font-display text-[10px] font-bold uppercase tracking-widest text-white">
                                Próximamente
                              </span>
                            )}
                          </div>
                          <h3 class="mt-1.5 font-display text-base font-bold text-dark sm:text-lg">{hito.titulo}</h3>
                          <p class="mt-1.5 font-body text-sm leading-relaxed text-dark/80">{hito.texto}</p>
                          {hito.puntos && (
                            <ul class="mt-2 flex list-disc flex-col gap-1 pl-5 font-body text-sm leading-relaxed text-dark/80 marker:text-primary">
                              {hito.puntos.map((punto) => <li>{punto}</li>)}
                            </ul>
                          )}
                          <a
                            href={hito.fuente.url}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="mt-2 inline-block font-body text-xs font-semibold text-primary-dark underline underline-offset-2"
                          >
                            Fuente: {hito.fuente.nombre} ↗
                          </a>
                        </article>
                      </li>
                    );
                  })}
                </ol>
              </section>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- Closing -->
  <section class="bg-white py-14 md:py-20">
    <div class="mx-auto max-w-2xl px-4 text-center sm:px-6 lg:px-8">
      <p class="font-display text-xs font-bold uppercase tracking-[0.3em] text-primary-dark">3 de noviembre de 2026</p>
      <h2 class="mt-2 font-display text-xl font-black uppercase tracking-tight text-dark sm:text-3xl">
        Lo que se vota en la <span class="text-gradient-multi">CTA</span>
      </h2>
      <div class="mx-auto mt-4 h-1 w-20 rounded-full gradient-multi"></div>

      <blockquote class="mt-8 rounded-2xl border-l-4 border-primary bg-light p-5 text-left shadow-sm sm:p-6">
        <p class="font-display text-lg font-bold leading-snug text-dark sm:text-xl">&ldquo;{SLOGAN_1}&rdquo;</p>
      </blockquote>
      <blockquote class="mt-4 rounded-2xl border-l-4 border-secondary bg-light p-5 text-left shadow-sm sm:p-6">
        <p class="font-display text-base font-semibold leading-snug text-dark sm:text-lg">&ldquo;{SLOGAN_2}&rdquo;</p>
      </blockquote>

      <div class="mt-8 text-left">
        <Pendiente descripcion="el texto de la lista sobre la historia de la CTA y su propuesta" />
      </div>

      <div class="mt-10 flex flex-col items-stretch gap-3 sm:flex-row sm:justify-center">
        <a
          href="/lista"
          class="inline-flex min-h-[48px] items-center justify-center gap-2 rounded-full bg-primary px-7 py-3.5 font-display text-base font-bold text-white shadow-lg transition-all duration-300 hover:bg-primary-dark active:scale-95 motion-safe:hover:scale-105"
        >
          Conocé la lista completa
        </a>
        <a
          href="/sumate"
          class="inline-flex min-h-[48px] items-center justify-center gap-2 rounded-full border-2 border-dark/15 bg-white px-7 py-3.5 font-display text-base font-bold text-dark transition-all duration-300 hover:border-primary hover:text-primary-dark active:scale-95 motion-safe:hover:scale-105"
        >
          Sumate
        </a>
      </div>
    </div>
  </section>

  <script>
    // Progressive enhancement only. Without JS (or with reduced motion), every
    // milestone stays visible — the hiding class is added by this script, never
    // present by default in the CSS.
    (function () {
      const chips = document.querySelectorAll<HTMLAnchorElement>('[data-era-chip]');
      const sections = document.querySelectorAll<HTMLElement>('section[id^="era-"]');

      if (sections.length && chips.length) {
        const eraObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              const id = entry.target.id.replace('era-', '');
              chips.forEach((chip) => {
                const active = chip.dataset.eraChip === id;
                chip.classList.toggle('is-active', active);
                chip.setAttribute('aria-current', active ? 'true' : 'false');
              });
            });
          },
          { rootMargin: '-104px 0px -70% 0px', threshold: 0 }
        );
        sections.forEach((s) => eraObserver.observe(s));
      }

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduceMotion) return;

      const cards = document.querySelectorAll<HTMLElement>('.reveal');
      if (!cards.length || !('IntersectionObserver' in window)) return;

      document.documentElement.classList.add('js-reveal-ready');

      const revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              revealObserver.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.1, rootMargin: '0px 0px -60px 0px' }
      );
      cards.forEach((c) => revealObserver.observe(c));
    })();
  </script>

  <style>
    .era-chip {
      display: inline-flex;
      flex-direction: column;
      min-height: 44px;
      justify-content: center;
      padding: 0.4rem 0.9rem;
      border-radius: 9999px;
      background: white;
      border: 1.5px solid rgb(0 0 0 / 0.1);
      font-family: var(--font-display, inherit);
      font-size: 0.7rem;
      font-weight: 700;
      color: rgb(0 0 0 / 0.65);
      text-decoration: none;
      transition: all 0.2s;
    }
    .era-chip:hover {
      border-color: rgb(196 30 42 / 0.4);
      color: rgb(196 30 42);
    }
    .era-chip.is-active {
      background: linear-gradient(90deg, #c41e2a, #e91e8e);
      border-color: transparent;
      color: white;
    }

    /* Reveal-on-scroll is opt-in via JS: without .js-reveal-ready, cards are
       always fully visible (no-JS and prefers-reduced-motion both land here). */
    .js-reveal-ready .reveal {
      opacity: 0;
      transform: translateY(16px);
      transition: opacity 0.5s ease, transform 0.5s ease;
    }
    .js-reveal-ready .reveal.is-visible {
      opacity: 1;
      transform: translateY(0);
    }
  </style>
</Layout>
